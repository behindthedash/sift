{
  "name": "@sift-grid/react",
  "version": "0.1.1",
  "description": "Sift — MIT-licensed React data grid for TanStack Table V9",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo": "vite --host 127.0.0.1",
    "release:check": "node scripts/verify-package.mjs",
    "release:workflow:check": "node scripts/verify-release-workflow.mjs",
    "release:manager:check": "node scripts/verify-release-manager.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 || >=19.0.0",
    "react-dom": ">=18.3.0 || >=19.0.0",
    "tailwindcss": ">=3.4.0 || >=4.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.13.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "tailwind-merge": "^3.3.0",
    "@floating-ui/react": "^0.27.0",
    "@tanstack/react-store": "^0.11.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behindthedash/sift.git"
  },
  "homepage": "https://github.com/behindthedash/sift#readme",
  "bugs": {
    "url": "https://github.com/behindthedash/sift/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
